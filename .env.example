APP_NAME="RE-FiX"
APP_ENV=production
APP_DEBUG=false
# Wird von ./setup.sh automatisch erzeugt. Leer lassen ist auch möglich: dann erzeugt die App beim ersten Start einen.
APP_KEY=
# Adresse, unter der die App erreichbar ist (intern oder über den Proxy). Jederzeit änderbar, danach: docker compose up -d
APP_URL=http://192.168.1.10:8383
# Port auf dem Docker-Host
APP_PORT=8383
APP_LOCALE=de
APP_TIMEZONE=Europe/Berlin

# Vertrauenswürdige Proxys (Nginx Proxy Manager). "*" = alle, oder IP/Netz, z. B. 172.18.0.0/16
TRUSTED_PROXIES=*
# Auf true setzen, sobald die App nur noch über HTTPS genutzt wird.
SESSION_SECURE_COOKIE=false

# Standard der Zwei-Faktor-Anmeldung für Benutzer, die nie entschieden haben (true = an). Jeder Benutzer ändert das selbst im Profil.
# Bei Zugriff von außen empfehlen wir true.
REQUIRE_2FA=true

# Datenbank (eigener MariaDB-Container im selben Stack). Passwörter erzeugt ./setup.sh.
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=rechnung
DB_USERNAME=rechnung
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_LEVEL=info

# Optional: Admin beim ersten Start automatisch anlegen. Leer lassen, um stattdessen die Einrichtungsseite zu nutzen.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
ADMIN_COMPANY=
