# Vorlage für das Feld "Umgebung" in OpenMediaVault (Dienste > Compose > Dateien > Datei bearbeiten)
# bzw. für eine .env neben der docker-compose.yml. Zeilen mit # sind Kommentare.

# --- Pflicht -----------------------------------------------------------------------------------
# Ordner auf dem NAS, in den du das Archiv entpackt hast (dort liegt das Dockerfile). Nur bei OMV nötig.
APP_SOURCE=/srv/dev-disk-by-uuid-XXXXXXXX/appdata/rechnungsapp

# Zwei lange, zufällige Passwörter (nur Buchstaben und Ziffern, mindestens 24 Zeichen).
DB_PASSWORD=HIER-ZUFAELLIGES-PASSWORT-EINTRAGEN
DB_ROOT_PASSWORD=HIER-EIN-ANDERES-ZUFAELLIGES-PASSWORT

# --- Erreichbarkeit ----------------------------------------------------------------------------
# Adresse, unter der du die App aufrufst. Jederzeit änderbar, danach Stack neu starten.
APP_URL=http://192.168.1.10:8383
APP_PORT=8383
# Später, wenn nur noch per HTTPS genutzt wird: APP_URL=https://rechnung.example.com und SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false

# --- Speicherorte (optional) -------------------------------------------------------------------
# Leer lassen = Docker-Volumes. Oder Pfade auf dem NAS, dann siehst du die Daten im Dateisystem und kannst sie sichern.
# Die Ordner werden automatisch angelegt.
#DB_DATA=/srv/dev-disk-by-uuid-XXXXXXXX/appdata/rechnung/db
#STORAGE_DATA=/srv/dev-disk-by-uuid-XXXXXXXX/appdata/rechnung/storage

# --- Sicherheit --------------------------------------------------------------------------------
# Standard der Zwei-Faktor-Anmeldung für Benutzer, die nie entschieden haben (true = an); jeder Benutzer ändert das im Profil.
# Bei Zugriff von außen empfehlen wir true.
REQUIRE_2FA=true
# Vertrauenswürdige Proxys (Nginx Proxy Manager). "*" = alle, oder IP bzw. Netz, z. B. 192.168.1.0/24
TRUSTED_PROXIES=*

# --- Optional ----------------------------------------------------------------------------------
# APP_KEY leer lassen: wird beim ersten Start erzeugt und im Storage abgelegt (mitsichern!).
#APP_KEY=
#APP_NAME=Rechnungsprogramm
# Admin beim ersten Start automatisch anlegen (sonst Einrichtungsseite). Passwort mindestens 12 Zeichen.
#ADMIN_EMAIL=
#ADMIN_NAME=
#ADMIN_PASSWORD=
#ADMIN_COMPANY=
